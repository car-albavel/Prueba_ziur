@page "/"
@page "/movimientos"
@rendermode InteractiveServer
@using Prueba_Ziur.Models
@using Prueba_Ziur.Services
@inject IZiurCatalogService Catalog

<PageTitle>Movimientos de inventario</PageTitle>

<h1>Movimientos de inventario</h1>

<div class="row g-2 mb-3 align-items-center">
    <div class="col-md-6">
        <input class="form-control" placeholder="Buscar por código o descripción..."
               aria-label="Buscar" @bind="Search" @bind:event="oninput" />
    </div>
    <div class="col-auto">
        <button class="btn btn-primary" @onclick="LoadAsync" disabled="@_loading">Recargar</button>
    </div>
    <div class="col-auto text-muted">@Filtered.Count de @_items.Count registros</div>
</div>

@if (_loading)
{
    <div class="d-flex align-items-center gap-2" role="status">
        <div class="spinner-border spinner-border-sm"></div> Cargando datos...
    </div>
}
else if (_error is not null)
{
    <div class="alert alert-danger" role="alert">
        @_error
        <button class="btn btn-sm btn-outline-danger ms-2" @onclick="LoadAsync">Reintentar</button>
    </div>
}
else if (Filtered.Count == 0)
{
    <div class="alert alert-info">No hay resultados.</div>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th role="button" @onclick='() => SortBy("Codigo")'>Código @Arrow("Codigo")</th>
                <th role="button" @onclick='() => SortBy("Descripcion")'>Descripción @Arrow("Descripcion")</th>
                <th role="button" @onclick='() => SortBy("VActiva")'>Activa @Arrow("VActiva")</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var m in Filtered)
            {
                <tr>
                    <td>@m.Codigo</td>
                    <td>@m.Descripcion</td>
                    <td>
                        <span class="badge @(m.VActiva ? "bg-success" : "bg-secondary")">@(m.VActiva ? "Sí" : "No")</span>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private IReadOnlyList<MovimientoInventario> _items = [];
    private bool _loading;
    private string? _error;
    private string _sortColumn = "Codigo";
    private bool _asc = true;

    private string Search { get; set; } = string.Empty;

    private List<MovimientoInventario> Filtered
    {
        get
        {
            var q = _items.AsEnumerable();
            var term = Search?.Trim();
            if (!string.IsNullOrEmpty(term))
                q = q.Where(m => m.Codigo.ToString().Contains(term)
                    || m.Descripcion.Contains(term, StringComparison.OrdinalIgnoreCase));

            Func<MovimientoInventario, object> key = _sortColumn switch
            {
                "Descripcion" => m => m.Descripcion,
                "VActiva" => m => m.VActiva,
                _ => m => m.Codigo
            };
            return (_asc ? q.OrderBy(key) : q.OrderByDescending(key)).ToList();
        }
    }

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _items = await Catalog.GetMovimientosAsync();
        }
        catch (ZiurApiException ex)
        {
            _error = ex.Message;
        }
        catch (Exception)
        {
            _error = "Ocurrió un error inesperado.";
        }
        finally
        {
            _loading = false;
        }
    }

    private void SortBy(string column)
    {
        _asc = _sortColumn == column ? !_asc : true;
        _sortColumn = column;
    }

    private string Arrow(string column) => _sortColumn != column ? "" : _asc ? "▲" : "▼";
}
